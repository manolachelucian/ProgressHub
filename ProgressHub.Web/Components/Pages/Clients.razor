@page "/clients"
@using ProgressHub.Core.Interfaces
@using ProgressHub.Core.Models.DTOs.ClientDTOs
@using ProgressHub.Web.Components.Clients
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Clients - ProgressHub</PageTitle>

<!-- Horní panel: KPI, Vyhledávání a Akce -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="card shadow-sm border-0" style="min-width: 200px;">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Total Clients</div>
                <h3 class="mb-0 fw-bold">@(_clients?.Count ?? 0)</h3>
            </div>
            <div class="fs-4 text-primary bg-light rounded p-2">👥</div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <div class="input-group" style="max-width: 280px;">
            <input type="text"
                   class="form-control"
                   placeholder="Search by name..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearSearch">&times;</button>
            }
        </div>
        <select class="form-select" style="max-width: 190px;" @bind="_selectedSort">
            <option value="@ClientSortOption.NewestFirst">Newest First</option>
            <option value="@ClientSortOption.OldestFirst">Oldest First</option>
            <option value="@ClientSortOption.NameAsc">Name (A &rarr; Z)</option>
            <option value="@ClientSortOption.NameDesc">Name (Z &rarr; A)</option>
        </select>

        <!-- Akční tlačítko -->
        <button class="btn btn-primary text-nowrap" @onclick="OpenAddClientModal">
            + Add New Client
        </button>
    </div>
</div>

<!-- Hlavní zobrazení dat -->
@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading clients...</span>
        </div>
        <p class="text-muted mt-2 mb-0">Loading clients...</p>
    </div>
}
else if (!FilteredAndSortedClients.Any())
{
    @if (string.IsNullOrWhiteSpace(_searchTerm))
    {
        <div class="alert alert-info border-0 shadow-sm">
            No clients found. Click <strong>+ Add New Client</strong> to create your first client.
        </div>
    }
    else
    {
        <div class="alert alert-warning border-0 shadow-sm">
            No clients found matching "<strong>@_searchTerm</strong>".
        </div>
    }
}
else
{
    <div class="card shadow-sm border-0">
        <!-- Tabulka s fixní výškou a sticky hlavičkou -->
        <div class="table-responsive" style="max-height: 560px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light sticky-top shadow-sm">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Target Calories</th>
                        <th>Latest Weight</th>
                        <th>Joined</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in PagedClients)
                    {
                        <tr style="cursor: pointer;" @onclick="() => NavigateToDetail(client.Id)">
                            <td><strong>@client.FullName</strong></td>
                            <td>@client.Email</td>
                            <td>@client.TargetCalories kcal</td>
                            <td>@FormatWeight(client.LatestWeight)</td>
                            <td class="text-muted small">@client.CreatedAt.ToString("dd-MM-yyyy")</td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm me-1"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => NavigateToDetail(client.Id)">
                                    View Detail &rarr;
                                </button>
                                <button class="btn btn-outline-danger btn-sm"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => HandleDeleteClientAsync(client)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Stránkovací lišta -->
        <div class="card-footer bg-white border-top py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 text-muted small">
                <span>Showing @GetShowingRangeText() of @FilteredCount clients</span>
                <span class="mx-1">&bull;</span>
                <span>Per page:</span>
                <select class="form-select form-select-sm" style="width: 75px;" @bind="PageSize">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>

            @if (TotalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(_currentPage - 1)">&lsaquo;</button>
                        </li>

                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageIndex = i;
                            <li class="page-item @(_currentPage == pageIndex ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageIndex)">@pageIndex</button>
                            </li>
                        }

                        <li class="page-item @(_currentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(_currentPage + 1)">&rsaquo;</button>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
}

<!-- Dialog pro vytvoření klienta -->
<AddClientModal IsOpen="_showAddClientModal"
                OnClose="CloseAddClientModal"
                OnClientAdded="HandleClientAddedAsync" />

@code {
    private enum ClientSortOption
    {
        NewestFirst,
        OldestFirst,
        NameAsc,
        NameDesc
    }

    private List<ClientListItemDto> _clients = new();
    private bool _isLoading = true;
    private bool _showAddClientModal;
    private string _searchTerm = string.Empty;
    private ClientSortOption _selectedSort = ClientSortOption.NewestFirst;

    // Stránkování
    private int _currentPage = 1;
    private int _pageSize = 10;

    private int PageSize
    {
        get => _pageSize;
        set
        {
            if (_pageSize != value)
            {
                _pageSize = value;
                _currentPage = 1;
            }
        }
    }

    private IEnumerable<ClientListItemDto> FilteredAndSortedClients
    {
        get
        {
            var query = _clients.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                query = query.Where(c => c.FullName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                         c.Email.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            return _selectedSort switch
            {
                ClientSortOption.OldestFirst => query.OrderBy(c => c.CreatedAt),
                ClientSortOption.NameAsc => query.OrderBy(c => c.FullName),
                ClientSortOption.NameDesc => query.OrderByDescending(c => c.FullName),
                _ => query.OrderByDescending(c => c.CreatedAt)
            };
        }
    }

    private int FilteredCount => FilteredAndSortedClients.Count();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)_pageSize));

    private IEnumerable<ClientListItemDto> PagedClients =>
        FilteredAndSortedClients
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        _isLoading = true;
        try
        {
            _clients = await UserService.GetAllClientsAsync();
            _currentPage = 1;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoToPage(int targetPage)
    {
        if (targetPage >= 1 && targetPage <= TotalPages)
        {
            _currentPage = targetPage;
        }
    }

    private string GetShowingRangeText()
    {
        if (FilteredCount == 0) return "0";
        var from = ((_currentPage - 1) * _pageSize) + 1;
        var to = Math.Min(_currentPage * _pageSize, FilteredCount);
        return $"{from}-{to}";
    }

    private void OpenAddClientModal() => _showAddClientModal = true;
    private void CloseAddClientModal() => _showAddClientModal = false;

    private async Task HandleClientAddedAsync()
    {
        _showAddClientModal = false;
        await LoadClientsAsync();
    }

    private void NavigateToDetail(int clientId) =>
        NavigationManager.NavigateTo($"/clients/{clientId}");

    private static string FormatWeight(double? weight) =>
        weight.HasValue ? $"{weight.Value:0.0} kg" : "—";

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _currentPage = 1;
    }

    private async Task HandleDeleteClientAsync(ClientListItemDto client)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete client {client.FullName} and all their logs?");

        if (confirmed)
        {
            await UserService.RemoveClientAsync(client.Id);
            await LoadClientsAsync();
        }
    }
}