@page "/clients"
@using ProgressHub.Core.Interfaces
@using ProgressHub.Core.Models
@using ProgressHub.Core.Exceptions
@using ProgressHub.Core.Enums
@using ProgressHub.Web.Components.Clients
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Clients - ProgressHub</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Clients</h1>
    <button class="btn btn-primary" @onclick="OpenAddClientModal">
        + Add New Client
    </button>
</div>

@if (_isLoading)
{
    <p><em>Loading clients...</em></p>
}
else if (_clients.Count == 0)
{
    <div class="alert alert-info">
        No clients found. Click <strong>+ Add New Client</strong> to create your first client.
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Target Calories</th>
                <th>Latest Weight</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in _clients)
            {
                <tr style="cursor: pointer;" @onclick="() => NavigateToDetail(client.Id)">
                    <td><strong>@client.GetFullName()</strong></td>
                    <td>@client.Email</td>
                    <td>@client.TargetCalories kcal</td>
                    <td>@GetLatestWeightDisplay(client)</td>
                    <td>
                        <button class="btn btn-outline-primary btn-sm" @onclick:stopPropagation="true" @onclick="() => NavigateToDetail(client.Id)">
                            View Detail &rarr;
                        </button>
                        <button class="btn btn-outline-danger btn-sm"
                                @onclick:stopPropagation="true"
                                @onclick="() => HandleDeleteClient(client)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<AddClientModal IsOpen="_isAddModalOpen" 
                OnClose="() => _isAddModalOpen = false" 
                OnClientAdded="LoadClientsAsync" />

@code {
    private List<User> _clients = new();
    private bool _isLoading = true;
    private bool _isAddModalOpen;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        _isLoading = true;
        _clients = await UserService.GetAllClientsAsync();
        _isLoading = false;
    }
    private void OpenAddClientModal()
    {
        _isAddModalOpen = true;
    }
    private void NavigateToDetail(int clientId)
    {
        NavigationManager.NavigateTo($"/clients/{clientId}");
    }

    private string GetLatestWeightDisplay(User client)
    {
        var latest = client.DailyLogs.OrderByDescending(l => l.Date).FirstOrDefault();
        return latest is null ? "—" : $"{latest.Weight:0.0} kg";
    }

    private async Task HandleDeleteClient(User client)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete client {client.GetFullName()} and all their logs?");

        if (confirmed)
        {
            await UserService.RemoveClientAsync(client.Id);
            await LoadClientsAsync();
        }
    }
}