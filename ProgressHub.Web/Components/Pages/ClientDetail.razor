@page "/clients/{Id:int}"
@using ProgressHub.Core.Interfaces
@using ProgressHub.Core.Models
@inject IUserService UserService;
@inject NavigationManager NavigationManager;
@using ProgressHub.Web.Components.ClientsDetail;
@inject IJSRuntime JSRuntime;
@using ProgressHub.Core.Services.MacroCalculator;
<PageTitle>Client Detail</PageTitle>

@if (_isLoading)
{
    <p><em>Loading client...</em></p>
}
else if (_client is null)
{
    <p>Client not found.</p>
    <button class="btn btn-secondary" @onclick="BackToList">Back to Clients</button>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <button class="btn btn-link px-0 text-decoration-none" @onclick="BackToList">&larr; Back to Clients</button>
        <div>
            <button class="btn btn-outline-primary btn-sm me-2" @onclick="() => _showTdeeModal = true">
                Calculator
            </button>
            <button class="btn btn-outline-secondary btn-sm me-2" @onclick="OpenEditProfileModal">Edit Profile</button>
            <button class="btn btn-outline-danger btn-sm" @onclick="HandleDeleteClient" disabled="@_isDeleting">
                @(_isDeleting ? "Deleting..." : "Delete Client")
            </button>
        </div>
    </div>

    <div class="mb-4">
        <h1 class="mb-0">@_client.GetFullName()</h1>
        <p class="text-muted">@_client.Email</p>
    </div>

    <!-- KPI -->
    <ClientKpiSummaryCard Client="_client" />

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <ClientBiometricsCard Client="_client" LatestLog="GetLatestLog()" />
        </div>
        <div class="col-md-6 mb-3">
            <ClientMacroCard Client="_client" />
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0">Daily Log History</h4>
        <button class="btn btn-primary btn-sm" @onclick="OpenAddLogModal">+ Add Daily Log</button>
    </div>

    <DailyLogsTable Logs="_client.DailyLogs" OnEdit="OpenEditLogModal" OnDelete="HandleDeleteLog" />

    <!-- Tdee Calculator -->
    <TdeeCalculatorModal IsOpen = "_showTdeeModal"
                     Client = "_client"
                     LatestLog = "GetLatestLog()"
                     OnApply = "HandleApplyMacros"
                     OnClose = "() => _showTdeeModal = false" />

    <!-- Edit profile -->
    <EditProfileModal IsOpen="_showEditProfileModal"
                      Model="_editClientModel"
                      IsSubmitting="_isSubmitting"
                      ErrorMessage="@_profileError"
                      OnSave="HandleUpdateClient"
                      OnClose="CloseEditProfileModal" />

    <!-- Daily log -->
    <DailyLogModal IsOpen="_showAddLogModal"
                   IsEditing="_isEditingLog"
                   Model="_newLog"
                   IsSubmitting="_isSubmitting"
                   ErrorMessage="@_submitError"
                   OnSave="HandleSaveLog"
                   OnClose="CloseAddLogModal" />
}

@code {
    [Parameter] public int Id { get; set; }

    private User? _client;
    private User _editClientModel = new();
    private DailyLog _newLog = new();

    private bool _isLoading = true;
    private bool _isDeleting;
    private bool _showAddLogModal;
    private bool _showEditProfileModal;
    private bool _isEditingLog;
    private bool _isSubmitting;
    private string? _profileError;
    private string? _submitError;

    private bool _showTdeeModal;


    private async Task HandleApplyMacros(MacroCalculationResult result)
    {
        if (_client is null) return;

        _client.TargetCalories = result.TargetCalories;
        _client.TargetProteinGrams = result.TargetProteinGrams;
        _client.TargetCarbsGrams = result.TargetCarbsGrams;
        _client.TargetFatsGrams = result.TargetFatsGrams;

        try
        {
            await UserService.UpdateClientAsync(_client);
            _showTdeeModal = false;
            await LoadClientAsync();
        }
        catch (Exception)
        {
            _submitError = "Failed to update target macros.";
        }
    }

    protected override async Task OnInitializedAsync() => await LoadClientAsync();

    private async Task LoadClientAsync()
    {
        _client = await UserService.GetClientByIdAsync(Id);
        _isLoading = false;
    }

    private DailyLog? GetLatestLog() =>
        _client?.DailyLogs.OrderByDescending(l => l.Date).FirstOrDefault();

    private void BackToList() => NavigationManager.NavigateTo("/clients");

    private void OpenEditProfileModal()
    {
        if (_client is null) return;

        _editClientModel = new User
        {
            Id = _client.Id,
            FirstName = _client.FirstName,
            LastName = _client.LastName,
            Email = _client.Email,
            DateOfBirth = _client.DateOfBirth,
            Gender = _client.Gender,
            FitnessGoal = _client.FitnessGoal,
            HeightInCm = _client.HeightInCm,
            TargetCalories = _client.TargetCalories,
            TargetProteinGrams = _client.TargetProteinGrams,
            TargetCarbsGrams = _client.TargetCarbsGrams,
            TargetFatsGrams = _client.TargetFatsGrams,
            UserRole = _client.UserRole
        };

        _profileError = null;
        _showEditProfileModal = true;
    }

    private void CloseEditProfileModal() => _showEditProfileModal = false;

    private async Task HandleUpdateClient()
    {
        _isSubmitting = true;
        _profileError = null;

        try
        {
            await UserService.UpdateClientAsync(_editClientModel);
            _showEditProfileModal = false;
            await LoadClientAsync();
        }
        catch (Exception)
        {
            _profileError = "Failed to update profile. Please check inputs and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenAddLogModal()
    {
        _isEditingLog = false;
        _newLog = new DailyLog
        {
            UserId = Id,
            Date = DateOnly.FromDateTime(DateTime.UtcNow)
        };
        _submitError = null;
        _showAddLogModal = true;
    }

    private void OpenEditLogModal(DailyLog log)
    {
        _isEditingLog = true;
        _newLog = new DailyLog
        {
            Id = log.Id,
            UserId = log.UserId,
            Date = log.Date,
            Weight = log.Weight,
            ConsumedCalories = log.ConsumedCalories,
            ConsumedProteins = log.ConsumedProteins,
            ConsumedCarbs = log.ConsumedCarbs,
            ConsumedFats = log.ConsumedFats,
            Note = log.Note
        };
        _submitError = null;
        _showAddLogModal = true;
    }

    private void CloseAddLogModal() => _showAddLogModal = false;

    private async Task HandleSaveLog()
    {
        _isSubmitting = true;
        _submitError = null;

        try
        {
            if (_isEditingLog)
            {
                await UserService.UpdateDailyLogAsync(_newLog);
            }
            else
            {
                await UserService.AddDailyLogAsync(_newLog);
            }

            _showAddLogModal = false;
            await LoadClientAsync();
        }
        catch (KeyNotFoundException)
        {
            _submitError = "The record or client was not found.";
        }
        catch (Exception)
        {
            _submitError = "Failed to save log. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleDeleteLog(DailyLog log)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete the log for {log.Date:yyyy-MM-dd}?");

        if (confirmed)
        {
            try
            {
                await UserService.RemoveDailyLogAsync(log.Id);
                await LoadClientAsync();
            }
            catch (Exception)
            {
                _submitError = "Failed to delete log. Please try again.";
            }
        }
    }

    private async Task HandleDeleteClient()
    {
        if (_client is null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to permanently delete {_client.GetFullName()} and all their recorded logs?");

        if (confirmed)
        {
            _isDeleting = true;
            try
            {
                await UserService.RemoveClientAsync(_client.Id);
                NavigationManager.NavigateTo("/clients");
            }
            catch (Exception)
            {
                _submitError = "Failed to delete client. Please try again.";
            }
            finally
            {
                _isDeleting = false;
            }
        }
    }
}

   
