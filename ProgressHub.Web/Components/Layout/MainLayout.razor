@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>

        <article class="content px-4 flex-grow-1">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger shadow-sm m-3" role="alert">
                        <h5 class="alert-heading">Something went wrong</h5>
                        <p class="mb-2">An unexpected error occurred while displaying this page.</p>
                        <button class="btn btn-outline-danger btn-sm" @onclick="Recover">Reload this page</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
        <footer class="app-footer py-3 px-4 border-top text-muted small bg-white">
            <div class="container-fluid p-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><strong>ProgressHub</strong> &copy; @DateTime.UtcNow.Year &bull; Coaching Platform</span>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle">System Online</span>
                    <span class="text-secondary">v1.0</span>
                </div>
            </div>
        </footer>
    </main>
</div>
@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover() => _errorBoundary?.Recover();
}
