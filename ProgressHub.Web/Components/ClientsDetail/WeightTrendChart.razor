@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@using ProgressHub.Core.Models

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h6 class="text-muted text-uppercase small fw-semibold mb-3">Weight Trend</h6>
        @if (Points.Count == 0)
{
    <p class="text-muted mb-0">No logs in the selected period.</p>
}
else
{
    <div class="chart-container">
        <canvas id="@_canvasId"></canvas>
    </div>
}
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<WeightTrendPoint> Points { get; set; } = Array.Empty<WeightTrendPoint>();
    private IReadOnlyList<WeightTrendPoint> _lastRenderedPoints = Array.Empty<WeightTrendPoint>();

    private readonly string _canvasId = $"weight-chart-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private bool _hasRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/progressChart.js");
        }

        if (_module is null || Points.SequenceEqual(_lastRenderedPoints, PointComparer.Instance))
        {
            return;
        }

        _lastRenderedPoints = Points;

        if (Points.Count == 0)
        {
            if (_hasRendered)
            {
                await _module.InvokeVoidAsync("destroyChart", _canvasId);
                _hasRendered = false;
            }
            return;
        }

        await _module.InvokeVoidAsync("renderChart", _canvasId, BuildChartConfig());
        _hasRendered = true;
    }

    private sealed class PointComparer : IEqualityComparer<WeightTrendPoint>
    {
        public static readonly PointComparer Instance = new();
        public bool Equals(WeightTrendPoint? x, WeightTrendPoint? y) =>
            x?.Date == y?.Date && x?.Weight == y?.Weight && x?.MovingAverage == y?.MovingAverage;
        public int GetHashCode(WeightTrendPoint p) => HashCode.Combine(p.Date, p.Weight, p.MovingAverage);
    }

    private object BuildChartConfig()
    {
        var labels = Points.Select(p => p.Date.ToString("dd-MM")).ToArray();

        return new
        {
            type = "line",
            data = new
            {
                labels,
                datasets = new object[]
                {
                    new
                    {
                        label = "Weight (kg)",
                        data = Points.Select(p => p.Weight).ToArray(),
                        borderColor = "#0d6efd",
                        backgroundColor = "rgba(13,110,253,0.1)",
                        tension = 0.2,
                        pointRadius = 3,
                        spanGaps = true
                    },
                    new
                    {
                        label = "Moving average",
                        data = Points.Select(p => p.MovingAverage).ToArray(),
                        borderColor = "#6c757d",
                        borderDash = new[] { 5, 5 },
                        pointRadius = 0,
                        tension = 0.3,
                        spanGaps = true
                    }
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                interaction = new { mode = "index", intersect = false },
                plugins = new { legend = new { position = "bottom" } },
                scales = new { y = new { title = new { display = true, text = "kg" } } }
            }
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyChart", _canvasId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                
            }
        }
    }
}