@using ProgressHub.Core.Models;

<div class="ph-card h-100">
    <div class="ph-card-body">
        <div class="ph-section-title">Client &amp; contact</div>
        <table class="table table-sm align-middle mb-3">
            <tbody>
                <tr>
                    <th class="ph-label fw-normal">Email</th>
                    <td>
                        <a href="mailto:@Client.Email" class="text-decoration-none" style="color: var(--ph-ink);">@Client.Email</a>
                    </td>
                </tr>
                <tr>
                    <th class="ph-label fw-normal">Phone</th>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(Client.PhoneNumber))
                        {
                            <a href="tel:@Client.PhoneNumber" class="text-decoration-none" style="color: var(--ph-ink);">
                                @Client.PhoneNumber
                            </a>
                        }
                        else
                        {
                            <span class="ph-label">—</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th class="ph-label fw-normal">Client since</th>
                    <td>@Client.CreatedAt.ToString("dd MMM yyyy")</td>
                </tr>
            </tbody>
        </table>

        <hr class="my-3" style="border-color: var(--ph-border); opacity: 1;" />

        <div class="ph-section-title">Biometrics &amp; goal</div>
        <div class="row g-3 mb-1">
            <div class="col-6">
                <div class="ph-label">Current weight</div>
                <div class="ph-metric-sm">@(LatestLog is null ? "—" : $"{LatestLog.Weight:0.0}")<span class="ph-metric-unit">kg</span></div>
            </div>
            <div class="col-6">
                <div class="ph-label">BMI</div>
                @if (CalculatedBmi is not null)
                {
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="ph-metric-sm">@CalculatedBmi.Value.ToString("0.0")</span>
                        <span class="ph-badge @BmiBadgeClass">@BmiCategoryText</span>
                    </div>
                }
                else
                {
                    <div class="ph-metric-sm">—</div>
                }
            </div>
        </div>

        <table class="table table-sm align-middle mb-0 mt-2">
            <tbody>
                <tr>
                    <th class="ph-label fw-normal">Goal</th>
                    <td>@Client.FitnessGoal</td>
                </tr>
                <tr>
                    <th class="ph-label fw-normal">Gender</th>
                    <td>@Client.Gender</td>
                </tr>
                <tr>
                    <th class="ph-label fw-normal">Age</th>
                    <td>@Client.GetAge() yrs <span class="ph-label">(@Client.DateOfBirth.ToString("dd MMM yyyy"))</span></td>
                </tr>
                <tr>
                    <th class="ph-label fw-normal">Height</th>
                    <td>@Client.HeightInCm cm</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public User Client { get; set; } = null!;

    [Parameter]
    public DailyLog? LatestLog { get; set; }

    private double? CalculatedBmi =>
        LatestLog is null ? null : Client.CalculateBmi(LatestLog.Weight);

    private string BmiCategoryText => CalculatedBmi switch
    {
        null => "—",
        < 18.5 => "Underweight",
        >= 18.5 and < 25.0 => "Normal",
        >= 25.0 and < 30.0 => "Overweight",
        _ => "Obese"
    };

    private string BmiBadgeClass => CalculatedBmi switch
    {
        null => "ph-badge-neutral",
        < 18.5 => "ph-badge-warn",
        >= 18.5 and < 25.0 => "ph-badge-positive",
        >= 25.0 and < 30.0 => "ph-badge-warn",
        _ => "ph-badge-negative"
    };
}