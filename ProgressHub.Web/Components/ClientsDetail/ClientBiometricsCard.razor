@using ProgressHub.Core.Models;

<div class="card h-100 shadow-sm border-0">
    <div class="card-body p-3">
        <!-- Sekce Kontakt & Základní info -->
        <div class="text-uppercase text-muted fw-semibold small mb-2">Client & Contact</div>
        <table class="table table-sm align-middle mb-3">
            <tbody>
                <tr>
                    <th class="text-muted fw-normal">Email</th>
                    <td>
                        <a href="mailto:@Client.Email" class="text-decoration-none text-dark ">@Client.Email</a>
                    </td>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">Phone number</th>
                    <td >
                        @if (!string.IsNullOrWhiteSpace(Client.PhoneNumber))
                        {
                            <a href="tel:@Client.PhoneNumber" class="text-decoration-none text-body">
                                @Client.PhoneNumber
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">Created At</th>
                    <td>@Client.CreatedAt.ToString("dd.MM.yyyy")</td>
                </tr>
            </tbody>
        </table>

        <!-- Oddělovač -->
        <hr class="my-3 text-muted opacity-25" />

        <!-- Sekce Biometrie & Cíl -->
        <div class="text-uppercase text-muted fw-semibold small mb-2">Biometrics & Goal</div>
        <table class="table table-sm align-middle mb-0">
            <tbody>
                <tr>
                    <th class="text-muted fw-normal ">Goal</th>
                    <td><span>@Client.FitnessGoal</span></td>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">Gender</th>
                    <td>@Client.Gender</td>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">Age</th>
                    <td>@Client.GetAge() yrs (@Client.DateOfBirth.ToString("dd-MM-yyyy"))</td>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">Height</th>
                    <td>@Client.HeightInCm cm</td>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">Current Weight</th>
                    <td>@(LatestLog is null ? "—" : $"{LatestLog.Weight:0.0} kg")</td>
                </tr>
                <tr>
                    <th class="text-muted fw-normal">BMI</th>
                    <td>
                        @if (CalculatedBmi is not null)
                        {
                            <span class="fw-semibold me-1">@CalculatedBmi.Value.ToString("0.0")</span>
                            <span class="badge @BmiBadgeClass">@BmiCategoryText</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public User Client { get; set; } = null!;

    [Parameter]
    public DailyLog? LatestLog { get; set; }

    private double? CalculatedBmi =>
        LatestLog is null ? null : Client.CalculateBmi(LatestLog.Weight);

    private string BMIDisplay => LatestLog is null ? " - " : (Client.CalculateBmi(LatestLog.Weight)?.ToString("0.0") ?? " - ");

    private string BmiCategoryText => CalculatedBmi switch
    {
        null => "—",
        < 18.5 => "Underweight",
        >= 18.5 and < 25.0 => "Normal",
        >= 25.0 and < 30.0 => "Overweight",
        _ => "Obese"
    };

    private string BmiBadgeClass => CalculatedBmi switch
    {
        null => "bg-secondary",
        < 18.5 => "bg-info text-dark",
        >= 18.5 and < 25.0 => "bg-success",
        >= 25.0 and < 30.0 => "bg-warning text-dark",
        _ => "bg-danger"
    };

}
