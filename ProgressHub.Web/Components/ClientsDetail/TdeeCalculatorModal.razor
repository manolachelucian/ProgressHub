@using ProgressHub.Core.Models.Enums
@using ProgressHub.Core.Models
@using ProgressHub.Core.Interfaces
@using ProgressHub.Web.Components.Shared
@using ProgressHub.Core.Services.MacroCalculator;
@inject IMacroCalculatorService MacroCalculator;

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">TDEE & Macro Target Calculator</h5>
                    <button type="button" class="btn-close" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-4">
                        <!-- Levý sloupec: Vstupy -->
                        <div class="col-md-6 border-end">
                            <h6 class="text-muted text-uppercase small fw-bold mb-3">Parameters</h6>

                            <div class="mb-3">
                                <label class="form-label small mb-1">Target Goal</label>
                                <select class="form-select form-select-sm" @bind="_selectedGoal" @bind:after="Recalculate">
                                    <option value="@FitnessGoal.WeightLoss">Weight Loss (-500 kcal)</option>
                                    <option value="@FitnessGoal.MuscleGain">Muscle Gain (+300 kcal)</option>
                                    <option value="@FitnessGoal.Maintenance">Maintenance (0 kcal)</option>
                                    <option value="@FitnessGoal.Recomposition">Recomposition (-200 kcal)</option>
                                    <option value="@FitnessGoal.Endurance">Endurance (+100 kcal)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small mb-1">Activity Level</label>
                                <select class="form-select form-select-sm" @bind="_activityMultiplier" @bind:after="Recalculate">
                                    <option value="1.2">Sedentary (Little/no exercise)</option>
                                    <option value="1.375">Lightly Active (1-3 days/wk)</option>
                                    <option value="1.55">Moderately Active (3-5 days/wk)</option>
                                    <option value="1.725">Very Active (6-7 days/wk)</option>
                                    <option value="1.9">Extremely Active (Athletic/Physical)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small mb-1">Protein Target (0.5 – 5.0 g / kg)</label>
                                <input type="number" step="0.1" min="0.5" max="5.0"
                                       class="form-control form-control-sm @(IsProteinInvalid ? "is-invalid" : "")"
                                       @bind="_proteinPerKg" @bind:after="Recalculate" />
                                @if (IsProteinInvalid)
                                {
                                    <div class="invalid-feedback d-block small">
                                        Protein must be between 0.5 and 5.0 g/kg.
                                    </div>
                                }
                            </div>

                            <div class="card bg-light border-0 p-2 mt-3">
                                <div class="small text-muted">Client biometrics:</div>
                                <div class="fw-semibold small">
                                    @Client.Gender, @Client.GetAge() yrs, @Client.HeightInCm cm, @CurrentWeight kg
                                </div>
                            </div>
                        </div>

                        <!-- Pravý sloupec: Sjednocený výstup bez duplicit -->
                        <div class="col-md-6 ps-md-4">
                            <h6 class="text-muted text-uppercase small fw-bold mb-3">Calculated Output</h6>
                            @if (_result is not null && !IsProteinInvalid)
                            {
                                <div class="card border-0 bg-light p-3">
                                    <h6 class="text-muted text-uppercase small fw-semibold mb-2">Energy Expenditure</h6>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="small">BMR:</span>
                                        <strong>@_result.Bmr.ToString("N0") kcal</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-3">
                                        <span class="small">TDEE:</span>
                                        <strong>@_result.Tdee.ToString("N0") kcal</strong>
                                    </div>

                                    <hr class="my-2" />

                                    <h6 class="text-muted text-uppercase small fw-semibold mb-3">Target Nutrition Split</h6>

                                    <MacroSplitChart ProteinGrams="_result.TargetProteinGrams"
                                                     CarbsGrams="_result.TargetCarbsGrams"
                                                     FatsGrams="_result.TargetFatsGrams"
                                                     TotalCalories="_result.TargetCalories"
                                                     Height="130" />
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning small">
                                    Please enter a valid protein range (0.5 – 5.0 g/kg) to see calculations.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OnClose">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm"
                            @onclick="ApplyCalculatedMacros"
                            disabled="@(IsProteinInvalid || _result is null)">
                        Apply to Client Profile
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    //parametry co se vkladaji do instance
    [Parameter] public bool IsOpen { get; set; } 
    [Parameter, EditorRequired] public User Client { get; set; } = null!;
    [Parameter] public DailyLog? LatestLog { get; set; }
    [Parameter] public EventCallback<MacroCalculationResult> OnApply { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private double _activityMultiplier = 1.55;
    private FitnessGoal _selectedGoal;
    private double _proteinPerKg = 2.0;
    private MacroCalculationResult? _result;

    private bool IsProteinInvalid => _proteinPerKg < 0.5 || _proteinPerKg > 5.0;
    private double CurrentWeight => LatestLog?.Weight ?? 75.0;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _selectedGoal = Client.FitnessGoal;
            Recalculate();
        }
    }

    private void Recalculate()
    {
        if (IsProteinInvalid)
        {
            _result = null;
            return;
        }

        var input = new MacroCalculationInput
        {
            Gender = Client.Gender,
            AgeInYears = Client.GetAge(),
            HeightInCm = Client.HeightInCm,
            WeightInKg = CurrentWeight,
            ActivityMultiplier = _activityMultiplier,
            Goal = _selectedGoal,
            ProteinPerKg = _proteinPerKg
        };

        _result = MacroCalculator.Calculate(input);
    }

    private async Task ApplyCalculatedMacros()
    {
        if (_result is not null && !IsProteinInvalid)
        {
            await OnApply.InvokeAsync(_result);
        }
    }

    
}