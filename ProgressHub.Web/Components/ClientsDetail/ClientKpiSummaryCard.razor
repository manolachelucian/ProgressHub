@using ProgressHub.Core.Models.Enums
@using ProgressHub.Core.Interfaces
@using ProgressHub.Core.Models
@inject IClientAnalyticsService AnalyticsService

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="ph-stat-card">
            <div class="ph-label">Start weight</div>
            <div class="ph-metric mt-1">@StartWeightDisplay</div>
            <div class="ph-label">@StartDateDisplay</div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="ph-stat-card">
            <div class="ph-label">Current weight</div>
            <div class="ph-metric mt-1">@CurrentWeightDisplay</div>
            <div class="ph-label">7d avg: @SevenDayAvgDisplay</div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="ph-stat-card @DeltaStripeClass">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="ph-label">Period delta</span>
                <select class="border-0 ph-label bg-transparent shadow-none"
                        value="@SelectedWindow" @onchange="HandleWindowChange">
                    <option value="@AnalyticsTimeWindow.Days14">14 days</option>
                    <option value="@AnalyticsTimeWindow.Month1">1 month</option>
                    <option value="@AnalyticsTimeWindow.Months3">3 months</option>
                    <option value="@AnalyticsTimeWindow.Months6">6 months</option>
                    <option value="@AnalyticsTimeWindow.Year1">1 year</option>
                    <option value="@AnalyticsTimeWindow.AllTime">All-time</option>
                </select>
            </div>
            <div class="ph-label mb-1" style="font-size: 0.72rem;">@PeriodDateRangeDisplay</div>
            <div class="ph-metric @DeltaCssClass">@DeltaWeightDisplay</div>
            <div class="small @DeltaCssClass text-truncate" title="@(_summary?.DeltaContextText)">
                @(_summary?.DeltaContextText ?? "Awaiting data")
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="ph-stat-card @(HasActiveStreak ? "ph-stripe-positive" : "")">
            <div class="ph-label">Log streak</div>
            <div class="ph-metric mt-1">@StreakDisplay</div>
            <div class="ph-label">@TotalLogsDisplay</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public User Client { get; set; } = null!;

    [Parameter]
    public AnalyticsTimeWindow SelectedWindow { get; set; } = AnalyticsTimeWindow.Days14;

    [Parameter]
    public EventCallback<AnalyticsTimeWindow> SelectedWindowChanged { get; set; }

    private ClientAnalyticsSummary? _summary;

    protected override void OnParametersSet() => Recalculate();

    private void Recalculate() => _summary = AnalyticsService.CalculateSummary(Client, SelectedWindow);

    private async Task HandleWindowChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<AnalyticsTimeWindow>(e.Value?.ToString(), out var parsed))
        {
            await SelectedWindowChanged.InvokeAsync(parsed);
        }
    }

    private bool HasActiveStreak => (_summary?.CurrentStreak ?? 0) > 0;

    private string PeriodDateRangeDisplay
    {
        get
        {
            if (_summary?.PeriodStartDate is null || _summary?.PeriodEndDate is null)
                return "No data";

            return $"{_summary.PeriodStartDate.Value:dd-MM-yyyy} – {_summary.PeriodEndDate.Value:dd-MM-yyyy}";
        }
    }

    private string StartWeightDisplay =>
        _summary?.StartWeight is not null ? $"{_summary.StartWeight:0.0} kg" : "—";

    private string StartDateDisplay =>
        _summary?.StartDate is not null ? _summary.StartDate.Value.ToString("dd-MM-yyyy") : "No logs";

    private string CurrentWeightDisplay =>
        _summary?.CurrentWeight is not null ? $"{_summary.CurrentWeight:0.0} kg" : "—";

    private string SevenDayAvgDisplay =>
        _summary?.SevenDayAverageWeight is not null ? $"{_summary.SevenDayAverageWeight:0.0} kg" : "—";

    private string StreakDisplay =>
        HasActiveStreak ? $"🔥 {_summary!.CurrentStreak} days" : "—";

    private string TotalLogsDisplay =>
        $"{_summary?.TotalLogsCount ?? 0} total entries";

    private string DeltaWeightDisplay
    {
        get
        {
            if (_summary?.WeightDeltaVsStart is null) return "—";
            var sign = _summary.WeightDeltaVsStart > 0 ? "+" : "";
            return $"{sign}{_summary.WeightDeltaVsStart.Value:0.0} kg";
        }
    }

    private string DeltaCssClass => _summary?.DeltaColorStatus switch
    {
        "success" => "ph-text-positive",
        "danger" => "ph-text-negative",
        "warning" => "ph-text-warn",
        _ => "ph-label"
    };

    private string DeltaStripeClass => _summary?.DeltaColorStatus switch
    {
        "success" => "ph-stripe-positive",
        "danger" => "ph-stripe-negative",
        "warning" => "ph-stripe-warn",
        _ => ""
    };
}