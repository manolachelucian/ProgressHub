@using ProgressHub.Core.Models.Enums
@using ProgressHub.Core.Interfaces
@using ProgressHub.Core.Models
@inject IClientAnalyticsService AnalyticsService



<div class="row g-3 mb-4">
    <!-- Start Weight -->
    <div class="col-6 col-md-3">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body p-3">
                <div class="text-muted small fw-semibold text-uppercase">Start Weight</div>
                <div class="fs-4 fw-bold text-dark mt-1">@StartWeightDisplay</div>
                <div class="text-muted small">@StartDateDisplay</div>
            </div>
        </div>
    </div>

    <!-- Current Weight -->
    <div class="col-6 col-md-3">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body p-3">
                <div class="text-muted small fw-semibold text-uppercase">Current Weight</div>
                <div class="fs-4 fw-bold text-dark mt-1">@CurrentWeightDisplay</div>
                <div class="text-muted small">7d avg: @SevenDayAvgDisplay</div>
            </div>
        </div>
    </div>

    <!-- Period Average vs Start Weight (Delta) -->
    <div class="col-6 col-md-3">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Period Delta</span>
                    <select class="form-select form-select-sm py-0 px-1 w-auto border-0 text-muted small fw-semibold bg-transparent" value="@SelectedWindow" @onchange="HandleWindowChange">
                        <option value="@AnalyticsTimeWindow.Days14">14 days avg</option>
                        <option value="@AnalyticsTimeWindow.Month1">1 month avg</option>
                        <option value="@AnalyticsTimeWindow.Months3">3 months avg</option>
                        <option value="@AnalyticsTimeWindow.Months6">6 months avg</option>
                        <option value="@AnalyticsTimeWindow.Year1">1 year avg</option>
                        <option value="@AnalyticsTimeWindow.AllTime">All-time avg</option>
                    </select>
                </div>

                <!-- Datumový interval okna -->
                <div class="text-muted small mb-1" style="font-size: 0.75rem;">
                    @PeriodDateRangeDisplay
                </div>

                <div class="fs-4 fw-bold mt-1 @DeltaCssClass">
                    @DeltaWeightDisplay
                </div>
                <div class="small @DeltaCssClass text-truncate" title="@(_summary?.DeltaContextText)">
                    @(_summary?.DeltaContextText ?? "Awaiting data")
                </div>
            </div>
        </div>
    </div>

    <!-- Logging Streak -->
    <div class="col-6 col-md-3">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body p-3">
                <div class="text-muted small fw-semibold text-uppercase">Log Streak</div>
                <div class="fs-4 fw-bold text-dark mt-1">@StreakDisplay</div>
                <div class="text-muted small">@TotalLogsDisplay</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public User Client { get; set; } = null!;

    [Parameter]
    public AnalyticsTimeWindow SelectedWindow { get; set; } = AnalyticsTimeWindow.Days14;

    [Parameter]
    public EventCallback<AnalyticsTimeWindow> SelectedWindowChanged { get; set; }
    
    private ClientAnalyticsSummary? _summary;

    protected override void OnParametersSet() => Recalculate();

    private void Recalculate() => _summary = AnalyticsService.CalculateSummary(Client, SelectedWindow);

    private async Task HandleWindowChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<AnalyticsTimeWindow>(e.Value?.ToString(), out var parsed))
        {
            await SelectedWindowChanged.InvokeAsync(parsed);
        }
    }

    private string PeriodDateRangeDisplay
    {
        get
        {
            if (_summary?.PeriodStartDate is null || _summary?.PeriodEndDate is null)
                return "No data";

            return $"{_summary.PeriodStartDate.Value:dd-MM-yyyy} – {_summary.PeriodEndDate.Value:dd-MM-yyyy}";
        }
    }
    private string StartWeightDisplay =>
        _summary?.StartWeight is not null ? $"{_summary.StartWeight:0.0} kg" : "—";

    private string StartDateDisplay =>
        _summary?.StartDate is not null ? _summary.StartDate.Value.ToString("dd-MM-yyyy") : "No logs";

    private string CurrentWeightDisplay =>
        _summary?.CurrentWeight is not null ? $"{_summary.CurrentWeight:0.0} kg" : "—";

    private string SevenDayAvgDisplay =>
        _summary?.SevenDayAverageWeight is not null ? $"{_summary.SevenDayAverageWeight:0.0} kg" : "—";

    private string StreakDisplay =>
        (_summary?.CurrentStreak ?? 0) > 0 ? $"🔥 {_summary!.CurrentStreak} days" : "—";

    private string TotalLogsDisplay =>
        $"{_summary?.TotalLogsCount ?? 0} total entries";

    private string DeltaWeightDisplay
    {
        get
        {
            if (_summary?.WeightDeltaVsStart is null) return "—";
            var sign = _summary.WeightDeltaVsStart > 0 ? "+" : "";
            return $"{sign}{_summary.WeightDeltaVsStart.Value:0.0} kg";
        }
    }

    private string DeltaCssClass => _summary?.DeltaColorStatus switch
    {
        "success" => "text-success",
        "danger" => "text-danger",
        "warning" => "text-warning",
        "primary" => "text-primary",
        _ => "text-muted"
    };
}