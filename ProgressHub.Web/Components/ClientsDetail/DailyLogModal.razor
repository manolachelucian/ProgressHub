@using ProgressHub.Core.Models.DTOs.DailyLogDTOs
@using ProgressHub.Core.Models.Enums
@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(IsEditing ? "Edit Daily Log" : "Add Daily Log")</h5>
                    <button type="button" class="btn-close" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Model" OnValidSubmit="OnSave">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Date</label>
                            <InputDate class="form-control" @bind-Value="Model.Date" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Weight (kg)</label>
                            <InputNumber class="form-control" @bind-Value="Model.Weight" />
                        </div>

                        <div class="row">
                            <div class="col mb-3">
                                <label class="form-label">Calories</label>
                                <InputNumber class="form-control" @bind-Value="Model.ConsumedCalories" />
                            </div>
                            <div class="col mb-3">
                                <label class="form-label">Protein (g)</label>
                                <InputNumber class="form-control" @bind-Value="Model.ConsumedProteins" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col mb-3">
                                <label class="form-label">Carbs (g)</label>
                                <InputNumber class="form-control" @bind-Value="Model.ConsumedCarbs" />
                            </div>
                            <div class="col mb-3">
                                <label class="form-label">Fats (g)</label>
                                <InputNumber class="form-control" @bind-Value="Model.ConsumedFats" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Activity / Training</label>
                            <InputSelect class="form-select" @bind-Value="Model.TrainingType">
                                <option value="@TrainingType.RestDay">😴 Rest Day</option>
                                <option value="@TrainingType.FullBody">🏋️ Full Body</option>
                                <option value="@TrainingType.UpperBody">💪 Upper Body</option>
                                <option value="@TrainingType.LowerBody">🦵 Lower Body</option>
                                <option value="@TrainingType.Push">🔥 Push</option>
                                <option value="@TrainingType.Pull">🪵 Pull</option>
                                <option value="@TrainingType.Legs">🦵 Legs</option>
                                <option value="@TrainingType.Cardio">🏃 Cardio</option>
                                <option value="@TrainingType.Other">⚡ Other</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Note (optional)</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="Model.Note" />
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger">@ErrorMessage</div>
                        }

                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="OnClose">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                                @(IsSubmitting ? "Saving..." : (IsEditing ? "Save Changes" : "Save Log"))
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter, EditorRequired] public UpdateDailyLogDto Model { get; set; } = null!;
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}

